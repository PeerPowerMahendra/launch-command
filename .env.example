# ---------------------------------------------------------------
# Generation engine
# ---------------------------------------------------------------
# No key needed while you're pre-launch: the server uses your local
# Claude Code CLI (`claude`) automatically.
#
# When you go public, uncomment and paste your key from
# https://platform.claude.com — the server switches to the Anthropic
# API automatically on restart.
# ANTHROPIC_API_KEY=sk-ant-...

# Force an engine instead of auto-detecting (optional):
#   api          → always use the Anthropic API
#   claude-code  → always use the local Claude Code CLI
# GENERATION_MODE=auto

# Model for the local Claude Code engine (optional, e.g. sonnet / opus / haiku)
# CLAUDE_CODE_MODEL=sonnet

# Local port (optional, default 3000)
# PORT=3000
