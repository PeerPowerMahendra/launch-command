# ─── Launch Command v5 — environment ─────────────────────────────
# Copy to .env.local and fill in. Everything except ANTHROPIC_API_KEY
# is optional for local dev — the app runs and builds without them,
# and each service activates the moment its keys are present.

# Site (used for metadata / OG / canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Generation engine ──────────────────────────────────────────
# Two engines, auto-selected: the Anthropic API when ANTHROPIC_API_KEY
# is set, otherwise the local Claude Code CLI (`claude`) if it's on your
# PATH — free, no key, great for local dev. Force one with GENERATION_MODE.
#   GENERATION_MODE=api          → always use the Anthropic API
#   GENERATION_MODE=claude-code  → always use the local Claude Code CLI
# GENERATION_MODE=auto
# CLAUDE_CODE_MODEL=sonnet       # model for the local CLI engine (optional)

# Anthropic API key — get one at https://platform.claude.com.
# Leave blank locally to use the Claude Code CLI instead.
ANTHROPIC_API_KEY=

# ─── Supabase (auth + Postgres). Optional until you wire it. ─────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Upstash Redis (API rate limiting). Optional. ───────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Stripe (billing — Phase 4). Optional. ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=

# ─── PostHog (product analytics). Optional. ─────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
