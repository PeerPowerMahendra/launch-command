# ─── Launch Command v5 — environment ─────────────────────────────
# Copy to .env.local and fill in. Everything except ANTHROPIC_API_KEY
# is optional for local dev — the app runs and builds without them,
# and each service activates the moment its keys are present.

# Site (used for metadata / OG / canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Claude (REQUIRED for real generation) ──────────────────────
# Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Supabase (auth + Postgres). Optional until you wire it. ─────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Upstash Redis (API rate limiting). Optional. ───────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Stripe (billing — Phase 4). Optional. ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=

# ─── PostHog (product analytics). Optional. ─────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
